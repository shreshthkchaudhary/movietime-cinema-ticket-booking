{
  "info": {
    "name": "MovieTime Cinema Ticket Booking API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "movieId", "value": "" },
    { "key": "theatreId", "value": "" },
    { "key": "showId", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "theatreAdminId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Tester\",\n  \"email\": \"alice@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@movietime.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login (SuperAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@movietime.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Get Theatre Admins (SuperAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.admins && data.admins.length > 0) {",
                  "  pm.collectionVariables.set('theatreAdminId', data.admins[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/theatre-admins"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "List Movies",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.movies && data.movies.length > 0 && !pm.collectionVariables.get('movieId')) {",
                  "  pm.collectionVariables.set('movieId', data.movies[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/movies"
          }
        },
        {
          "name": "Get Movie By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/movies/{{movieId}}"
          }
        },
        {
          "name": "Create Movie (SuperAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.movie && data.movie._id) pm.collectionVariables.set('movieId', data.movie._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dune: Part Two\",\n  \"description\": \"Paul Atreides unites with the Fremen on Arrakis.\",\n  \"genre\": \"Sci-Fi\",\n  \"language\": \"English\",\n  \"durationMins\": 166,\n  \"posterUrl\": \"https://via.placeholder.com/300x450?text=Dune+2\",\n  \"releaseDate\": \"2024-03-01\"\n}"
            },
            "url": "{{baseUrl}}/api/movies"
          }
        },
        {
          "name": "Update Movie (SuperAdmin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationMins\": 167\n}"
            },
            "url": "{{baseUrl}}/api/movies/{{movieId}}"
          }
        },
        {
          "name": "Delete Movie (SuperAdmin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/movies/{{movieId}}"
          }
        },
        {
          "name": "[Negative] Normal User Creating Movie (403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Movie\",\n  \"description\": \"Should fail with 403 for normal user\",\n  \"genre\": \"Drama\",\n  \"language\": \"English\",\n  \"durationMins\": 100,\n  \"releaseDate\": \"2025-01-01\"\n}"
            },
            "url": "{{baseUrl}}/api/movies"
          }
        }
      ]
    },
    {
      "name": "Theatres",
      "item": [
        {
          "name": "List Theatres",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.theatres && data.theatres.length > 0 && !pm.collectionVariables.get('theatreId')) {",
                  "  pm.collectionVariables.set('theatreId', data.theatres[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/theatres"
          }
        },
        {
          "name": "My Theatres (TheatreAdmin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/theatres/my"
          }
        },
        {
          "name": "Get Theatre By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/theatres/{{theatreId}}"
          }
        },
        {
          "name": "Create Theatre (SuperAdmin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.theatre && data.theatre._id) pm.collectionVariables.set('theatreId', data.theatre._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"INOX City Center\",\n  \"city\": \"Delhi\",\n  \"address\": \"45 Connaught Place\",\n  \"owner\": \"{{theatreAdminId}}\",\n  \"screens\": [\n    { \"name\": \"Screen 1\", \"rows\": 5, \"seatsPerRow\": 8 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/theatres"
          }
        },
        {
          "name": "Update Theatre",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"46 Connaught Place\"\n}"
            },
            "url": "{{baseUrl}}/api/theatres/{{theatreId}}"
          }
        },
        {
          "name": "Delete Theatre (SuperAdmin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/theatres/{{theatreId}}"
          }
        }
      ]
    },
    {
      "name": "Shows",
      "item": [
        {
          "name": "List Shows",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.shows && data.shows.length > 0 && !pm.collectionVariables.get('showId')) {",
                  "  pm.collectionVariables.set('showId', data.shows[0]._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shows"
          }
        },
        {
          "name": "Get Show By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/shows/{{showId}}"
          }
        },
        {
          "name": "Create Show",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.show && data.show._id) pm.collectionVariables.set('showId', data.show._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"movie\": \"{{movieId}}\",\n  \"theatre\": \"{{theatreId}}\",\n  \"screenName\": \"Screen 1\",\n  \"startTime\": \"2027-01-15T18:30:00.000Z\",\n  \"price\": 280\n}"
            },
            "url": "{{baseUrl}}/api/shows"
          }
        },
        {
          "name": "Update Show",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 300\n}"
            },
            "url": "{{baseUrl}}/api/shows/{{showId}}"
          }
        },
        {
          "name": "Delete Show",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/shows/{{showId}}"
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.booking && data.booking._id) pm.collectionVariables.set('bookingId', data.booking._id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"{{showId}}\",\n  \"seats\": [\"A1\", \"A2\"]\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "[Negative] Double Book Same Seat (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"{{showId}}\",\n  \"seats\": [\"A1\"]\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "[Negative] Invalid Seat Label A01 (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"showId\": \"{{showId}}\",\n  \"seats\": [\"A01\"]\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "My Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/bookings/my"
          }
        },
        {
          "name": "Get Booking By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Movie Collection Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/reports/movies"
          }
        },
        {
          "name": "Show Collection Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/reports/shows"
          }
        }
      ]
    }
  ]
}
